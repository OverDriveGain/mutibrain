<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group re-added 2026-09-14 (paid team 7276Y3726M). Lets the broadcast
         extension read the server/token/agent_id the app writes at runtime, and
         lets the Screenpipe massam read cross-process capture counters. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.manarz.aiassistant</string>
    </array>
    <!-- APNs for agent text-share notifications (2026-09-25). "production" is the
         TestFlight / App Store environment (matches the server's default
         MYMU_APNS_ENV=production). For a direct Xcode DEBUG device build, switch
         this to "development" and set MYMU_APNS_ENV=sandbox server-side.
         Requires the App ID (com.manarz.myagent) to have Push Notifications
         enabled in the Apple Developer portal. -->
    <key>aps-environment</key>
    <string>production</string>
    <!-- Important reminders push with interruption-level time-sensitive
         (2026-10-30): without this entitlement iOS silently downgrades them. -->
    <key>com.apple.developer.usernotifications.time-sensitive</key>
    <true/>
</dict>
</plist>
